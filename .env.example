# Copy this file to .env only on the deployment host. Never commit the real value.
MQTT_PASSWORD=
JEBAO_FLOW_CONFIG=./config.yaml
# Generate once with: python -c 'import secrets; print(secrets.token_hex(16))'
# Store the private value durably. Never change it after provisioning the named volume.
# If lost, recover the exact marker value; never generate a replacement for that volume.
JEBAO_FLOW_HARDWARE_SAFETY_VOLUME_ID=
# Private attended-test config; never commit real MAC/vendor device IDs.
JEBAO_FLOW_HARDWARE_CONFIG=./config.hardware-test.yaml
