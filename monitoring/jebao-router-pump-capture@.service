[Unit]
Description=Read-only Jebao pump packet capture from router interface %i
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=exec
User=selian
ExecStart=/home/selian/.local/libexec/jebao-router-pump-capture.sh %i
Restart=always
RestartSec=10s
KillMode=control-group
TimeoutStopSec=15s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
